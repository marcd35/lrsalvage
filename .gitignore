# Rust
/target
**/*.rs.bk

# Extracted output from local runs
/out
/out-*
*.partial
lrsalvage-report-*

# Local real-catalog paths for the #[ignore]d tests; see .env.example.
.env

# Test-drive and PR evidence. `test-drive-and-fix` writes captures here and
# `pr-screenshots` reads them, so the directory needs to exist without being
# committed: an evidence folder in the tree is a folder somebody eventually adds.
/.agent/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# The wasm-bindgen output the two browser pages generate; the sources are in each
# crate's `web/`, and the two scripts rebuild it (`scripts/browser-parity.sh`,
# `scripts/browser-app.sh`).
/crates/lrsalvage-web/web/pkg/
/crates/lrsalvage-app/web/pkg/

# Wrangler's local Pages state
/.wrangler/
