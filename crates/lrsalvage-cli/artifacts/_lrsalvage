#compdef lrsalvage

autoload -U is-at-least

_lrsalvage() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_lrsalvage_commands" \
"*::: :->lrsalvage" \
&& ret=0
    case $state in
    (lrsalvage)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:lrsalvage-command-$line[1]:"
        case $line[1] in
            (scan)
_arguments "${_arguments_options[@]}" : \
'--catalog=[Catalog file (\`*.lrcat\`)]:CATALOG:_files' \
'--previews=[Preview cache directory (\`* Previews.lrdata\`)]:PREVIEWS:_files' \
'--contact-sheet=[Write a self-contained HTML contact sheet of the best previews]:CONTACT_SHEET:_files' \
'--report=[Write the path-free verification report to this file]:REPORT:_files' \
'--min-long-edge=[Ignore previews below this long edge]:MIN_LONG_EDGE:_default' \
'--max-long-edge=[Write the largest preview at or below this long edge, not the largest present. \`0\` disables the cap]:MAX_LONG_EDGE:_default' \
'--json[Emit a machine-readable summary instead of a table]' \
'--verbose[Print one line per plan item instead of only totals]' \
'--all-levels[Inspect every level, not only the best one]' \
'--include-present[Also include images whose original file is still present]' \
'--verify-source[Prove the catalog was only read\: hash it, copy it, hash the copy, and fail if the two disagree.]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(extract)
_arguments "${_arguments_options[@]}" : \
'--catalog=[]:CATALOG:_files' \
'--previews=[]:PREVIEWS:_files' \
'--out=[Destination directory. Must not be inside the catalog or cache]:OUT:_files' \
'--min-long-edge=[Ignore previews below this long edge]:MIN_LONG_EDGE:_default' \
'--max-long-edge=[Write the largest preview at or below this long edge, not the largest present. \`0\` disables the cap]:MAX_LONG_EDGE:_default' \
'--dry-run[Do everything except write files]' \
'--all-levels[]' \
'--include-present[Also include images whose original file is still present]' \
'--verify-source[Prove the catalog was only read\: hash it, copy it, hash the copy, and fail if the two disagree.]' \
'--no-metadata[Do not add EXIF, XMP rating or the ICC profile to the recovered JPEGs]' \
'--no-timestamps[Do not set file modification times to the capture time]' \
'--force[Replace an existing destination file that is not a verified extraction]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(masks)
_arguments "${_arguments_options[@]}" : \
'--data=[A \`<catalog>.lrcat-data\` directory]:DATA:_files' \
'--out=[]:OUT:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_lrsalvage__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:lrsalvage-help-command-$line[1]:"
        case $line[1] in
            (scan)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(extract)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(masks)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_lrsalvage_commands] )) ||
_lrsalvage_commands() {
    local commands; commands=(
'scan:Report what is recoverable. Writes nothing except the files you name' \
'extract:Write the recoverable JPEGs, plus a report and a JSON manifest' \
'masks:Decode \`.lrcat-data\` AI mask layers to PNG' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'lrsalvage commands' commands "$@"
}
(( $+functions[_lrsalvage__subcmd__extract_commands] )) ||
_lrsalvage__subcmd__extract_commands() {
    local commands; commands=()
    _describe -t commands 'lrsalvage extract commands' commands "$@"
}
(( $+functions[_lrsalvage__subcmd__help_commands] )) ||
_lrsalvage__subcmd__help_commands() {
    local commands; commands=(
'scan:Report what is recoverable. Writes nothing except the files you name' \
'extract:Write the recoverable JPEGs, plus a report and a JSON manifest' \
'masks:Decode \`.lrcat-data\` AI mask layers to PNG' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'lrsalvage help commands' commands "$@"
}
(( $+functions[_lrsalvage__subcmd__help__subcmd__extract_commands] )) ||
_lrsalvage__subcmd__help__subcmd__extract_commands() {
    local commands; commands=()
    _describe -t commands 'lrsalvage help extract commands' commands "$@"
}
(( $+functions[_lrsalvage__subcmd__help__subcmd__help_commands] )) ||
_lrsalvage__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'lrsalvage help help commands' commands "$@"
}
(( $+functions[_lrsalvage__subcmd__help__subcmd__masks_commands] )) ||
_lrsalvage__subcmd__help__subcmd__masks_commands() {
    local commands; commands=()
    _describe -t commands 'lrsalvage help masks commands' commands "$@"
}
(( $+functions[_lrsalvage__subcmd__help__subcmd__scan_commands] )) ||
_lrsalvage__subcmd__help__subcmd__scan_commands() {
    local commands; commands=()
    _describe -t commands 'lrsalvage help scan commands' commands "$@"
}
(( $+functions[_lrsalvage__subcmd__masks_commands] )) ||
_lrsalvage__subcmd__masks_commands() {
    local commands; commands=()
    _describe -t commands 'lrsalvage masks commands' commands "$@"
}
(( $+functions[_lrsalvage__subcmd__scan_commands] )) ||
_lrsalvage__subcmd__scan_commands() {
    local commands; commands=()
    _describe -t commands 'lrsalvage scan commands' commands "$@"
}

if [ "$funcstack[1]" = "_lrsalvage" ]; then
    _lrsalvage "$@"
else
    compdef _lrsalvage lrsalvage
fi
