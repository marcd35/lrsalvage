#!/bin/sh
# The cheap gates, on every commit: formatting and spelling are what a push
# turns red most often, and both finish in about a second. The gate list itself
# lives in `scripts/check.sh` and is named here, not repeated, so this hook
# cannot enforce a weaker command than CI does.
#
# Installed with `git config core.hooksPath .githooks` (AGENTS.md says so).
# Skip it deliberately with `git commit --no-verify`.
set -eu

cd "$(git rev-parse --show-toplevel)"
sh scripts/check.sh fmt typos
